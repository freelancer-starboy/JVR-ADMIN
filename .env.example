# Copy to .env.local and fill in real values. Never commit real secrets.

# MongoDB connection string (same database as the storefront)
MONGO_URI=

# Secret used to sign admin login tokens (JWT, HS256). Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Cloudinary account used for product images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail account + app password used to reply to contact-form enquiries
NODEMAILER_USER=sreejvrtextiles@gmail.com
NODEMAILER_APP_PASSWORD=
